# Réglages COMMUNS à tous les comptes : copie ce fichier en .env.shared (jamais dans git).
# Les comptes eux-mêmes (pseudo + mot de passe) se gèrent dans le panel : création automatique ou ajout.

# Jeton partagé panel <-> flotte : openssl rand -hex 32 (la MÊME valeur que PANEL_TOKEN dans .env.panel)
PANEL_TOKEN=

# Le compte qui reçoit les dons des autres (son pseudo). Il peut être un compte du panel ou un compte extérieur.
# Les autres lui proposent toutes leurs cartes qu'il n'a pas (jamais une carte en vente ou promise), un échange à la fois.
# Les comptes du panel s'ignorent automatiquement entre eux ; il reste exclu des échanges normaux.
HP_PRIORITY_TARGET=pseudo1

# Comptes extérieurs au panel à ignorer aussi (facultatif), séparés par des virgules
# HP_ACCOUNTS=

# Scripts à faire tourner sur tous les comptes (modifiables ensuite compte par compte depuis le panel)
# disponibles : auto-booster, echanges, vendre-doublons, recyclage, achat-revente, achat-manquantes
HP_SCRIPTS=auto-booster,echanges,vendre-doublons

# Booster ouvert si un compte n'a AUCUNE série en favori : nom ou identifiant (ex. Nuit Noire, me05)
HP_DEFAULT_BOOSTER=

# Si l'inscription automatique ne trouve pas la bonne adresse sur le site (voir le message d'erreur du panel) :
# HP_REGISTER_PATH=/api/auth/register

# Navigateur léger (par défaut) : pas d'images, de polices ni d'animations, minuteries d'affichage ralenties. 0 = navigateur complet.
# HP_LIGHT=1
