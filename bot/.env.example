# Copie ce fichier en .env.compte1 (et .env.compte2 pour le second compte)

# Identifiants HoloPocket (le bot se connecte et se reconnecte tout seul)
HP_USERNAME=pseudo
HP_PASSWORD=mot_de_passe

# Pseudo(s) de tes autres comptes, séparés par des virgules :
# jamais d'échange avec eux, jamais d'enchère sur leurs ventes (les comptes restent indépendants)
HP_EXCLUDE=autre_pseudo

# Scripts automatiques à faire tourner (séparés par des virgules)
# vendre-doublons, auto-booster, recyclage, echanges, achat-revente
HP_SCRIPTS=vendre-doublons,auto-booster,recyclage,echanges,achat-revente

# Optionnel
# HP_CHECK_UPDATES_MIN=15   # vérification des nouvelles versions sur GitHub
# HP_RELOAD_EVERY_H=6       # rechargement complet de la page
# HP_COOKIE=                # à la place du mot de passe : en-tête Cookie copié depuis ton navigateur
