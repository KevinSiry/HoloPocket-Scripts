# Panel de gestion HoloPocket : copie ce fichier en bot/.env.panel (jamais dans git)

# Sous-domaine public du panel (DNS : enregistrement A vers le VPS)
PANEL_DOMAIN=holo.chabow.fr

# Empreinte du mot de passe : node panel/hash-password.js
# (sans Node sur le VPS : docker run --rm -it -v "$PWD/panel":/app -w /app node:22-alpine node hash-password.js)
PANEL_PASSWORD_HASH=

# Clé de signature des sessions ET de chiffrement des mots de passe des comptes : openssl rand -hex 32
# Ne la change plus ensuite : les mots de passe enregistrés deviendraient illisibles.
PANEL_SECRET=

# Jeton partagé panel <-> flotte : openssl rand -hex 32
# La MÊME valeur va dans bot/.env.shared (PANEL_TOKEN=...)
PANEL_TOKEN=
