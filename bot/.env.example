# Identifiants d'UN compte : copie ce fichier en .env.compte1, .env.compte2…
# Les réglages communs (comptes, cible prioritaire, scripts, panel) sont dans .env.shared
HP_USERNAME=pseudo
HP_PASSWORD=mot_de_passe

# Réglages propres à ce compte (optionnels, ils passent avant .env.shared)
# HP_SCRIPTS=auto-booster,echanges
# HP_EXCLUDE=pseudo_a_ignorer_en_plus
# HP_COOKIE=                # à la place du mot de passe : en-tête Cookie copié depuis ton navigateur
# HP_CHECK_UPDATES_MIN=15   # vérification des nouvelles versions sur GitHub
# HP_RELOAD_EVERY_H=6       # rechargement complet de la page
