# Panel de gestion HoloPocket : copie ce fichier en .env.panel (jamais dans git)

# Sous-domaine public du panel (DNS : enregistrement A vers le VPS)
PANEL_DOMAIN=holo.chabow.fr

# Empreinte du mot de passe : node panel/hash-password.js
PANEL_PASSWORD_HASH=

# Clé de signature des sessions : openssl rand -hex 32
PANEL_SECRET=

# Jeton partagé panel <-> bots : openssl rand -hex 32
# La MÊME valeur va dans chaque .env.compteX (PANEL_TOKEN=...)
PANEL_TOKEN=

# Comptes à afficher : nom=adresse interne du bot (nom du service Docker)
PANEL_BOTS=compte1=http://compte1:3100,compte2=http://compte2:3100
