# Réglages COMMUNS à tous les comptes : copie ce fichier en .env.shared (jamais dans git)
# Les identifiants de chaque compte sont dans .env.compte1, .env.compte2… (HP_USERNAME et HP_PASSWORD seulement).

# Pseudos de TOUS tes comptes, séparés par des virgules.
# Chaque compte ignore automatiquement les autres : aucun échange, aucune enchère entre eux.
HP_ACCOUNTS=pseudo1,pseudo2,pseudo3

# Le compte qui reçoit les dons des autres (un des pseudos ci-dessus). Il ne se donne rien à lui-même.
# Les autres lui proposent toutes leurs cartes qu'il n'a pas (jamais une carte en vente ou promise), un échange à la fois.
HP_PRIORITY_TARGET=pseudo1

# Scripts à faire tourner sur tous les comptes (modifiables ensuite compte par compte depuis le panel)
# disponibles : auto-booster, echanges, vendre-doublons, recyclage, achat-revente
HP_SCRIPTS=auto-booster,echanges,vendre-doublons

# Booster ouvert si un compte n'a AUCUNE série en favori : nom ou identifiant (ex. Nuit Noire, me05)
HP_DEFAULT_BOOSTER=

# Jeton partagé avec le panel (même valeur que PANEL_TOKEN dans .env.panel)
PANEL_TOKEN=
